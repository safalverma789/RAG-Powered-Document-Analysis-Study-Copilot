{
  "name": "aura-rag-copilot",
  "version": "1.0.0",
  "description": "AURA RAG Study Copilot Full Stack Launcher",
  "scripts": {
    "start": "cmd /c start.bat",
    "dev": "cmd /c start.bat",
    "stop": "cmd /c stop.bat",
